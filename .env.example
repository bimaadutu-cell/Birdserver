# Railway PostgreSQL supplies this when the database is connected to the service.
DATABASE_URL=

# Optional. Defaults to admin/admin00.
BIRDSERVER_ADMIN_USERNAME=admin
BIRDSERVER_ADMIN_PASSWORD=admin00
BIRDSERVER_ADMIN_EMAIL=admin@birdserver.local
# Set to 1 ONCE if an existing admin password is unknown and must be reset.
# Remove/unset after successful recovery.
BIRDSERVER_RESET_ADMIN_PASSWORD=1
